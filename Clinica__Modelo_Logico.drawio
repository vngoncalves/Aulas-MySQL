        <mxCell id="19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;REGRAS CONVERTIDAS DO MER&lt;/b&gt;&lt;br/&gt;• N:N PACIENTE–CONVENIO → PACIENTE_CONVENIO.&lt;br/&gt;• N:N MEDICO–ESPECIALIDADE → MEDICO_ESPECIALIDADE.&lt;br/&gt;• Telefone multivalorado → TELEFONE_PACIENTE.&lt;br/&gt;• Supervisor → FK recursiva matricula_supervisor.&lt;br/&gt;• Pagamento usa duas FKs opcionais, mas um CHECK deve permitir somente uma origem.&lt;br/&gt;• codigo_consulta e codigo_solicitacao em PAGAMENTO são UNIQUE para representar 1:1." vertex="1">
          <mxGeometry height="180" width="670" x="520" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;LEGENDA&lt;/b&gt;&lt;br/&gt;PK = chave primária&lt;br/&gt;FK = chave estrangeira&lt;br/&gt;UQ = UNIQUE&lt;br/&gt;NOT NULL = obrigatório&lt;br/&gt;CHECK = regra de domínio/negócio" vertex="1">
          <mxGeometry height="135" width="350" x="1250" y="1115" as="geometry" />
