        <mxCell id="18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=7;verticalAlign=top;" value="&lt;div style=&quot;text-align:center;font-weight:bold;font-size:13px;&quot;&gt;FUNCIONARIO&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;PK/UQ matricula          INT&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;FK     matricula_supervisor INT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;       nome              VARCHAR(100) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;UQ     cpf               CHAR(11) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;       cargo             VARCHAR(50) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;       data_admissao     DATE NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;       salario           DECIMAL(10,2) NOT NULL&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;       telefone          VARCHAR(20)&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;CHECK salario &amp;gt;= 0&lt;/div&gt;&lt;div style=&quot;font-family:monospace;&quot;&gt;-&amp;gt; FUNCIONARIO(matricula) [supervisor]&lt;/div&gt;" vertex="1">
