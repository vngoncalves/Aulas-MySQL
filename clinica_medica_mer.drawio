        <mxCell id="98" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Participação&lt;/b&gt;&lt;br/&gt;• Paciente–Telefone: total (mínimo 1 telefone)&lt;br/&gt;• Médico–Especialidade: total (mínimo 1 especialidade)&lt;br/&gt;• Consulta–Paciente e Consulta–Médico: total&lt;br/&gt;• Paciente–Convênio: parcial (pode ser particular)&lt;br/&gt;• Funcionário–Supervisor: parcial" vertex="1">
          <mxGeometry height="120" width="520" x="20" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="99" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Regra de pagamento&lt;/b&gt;&lt;br/&gt;Cada PAGAMENTO deve referir-se a &lt;b&gt;uma CONSULTA OU uma SOLICITACAO_EXAME&lt;/b&gt;, nunca às duas.&lt;br/&gt;Pagamento via convênio exige CONVENIO." vertex="1">
          <mxGeometry height="100" width="500" x="555" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="100" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;" value="&lt;b&gt;Observação&lt;/b&gt;&lt;br/&gt;PACIENTE_CONVENIO resolve o N:N e guarda carteirinha, validade e tipo_vinculo.&lt;br/&gt;FUNCIONARIO usa relacionamento recursivo para supervisão." vertex="1">
